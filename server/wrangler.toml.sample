name = "00quiz-api"
main = "src/index.ts"
compatibility_date = "2026-10-17"
workers_dev = false
preview_urls = false
# Minified bundles load faster; uploaded source maps keep stack traces readable.
minify = true
upload_source_maps = true

[vars]
APP_NAME = "My Quiz"
PUBLIC_ORIGIN = "https://api.example.com"
APPLE_APP_CLIENT_ID = "com.example.zerozeroquiz"
APPLE_WEB_CLIENT_ID = "com.example.zerozeroquiz.web"
APPLE_WEB_REDIRECT_URI = "https://api.example.com/auth/apple/callback"
APPLE_TEAM_ID = "REPLACE_WITH_APPLE_TEAM_ID"
APPLE_KEY_ID = "REPLACE_WITH_SIGN_IN_WITH_APPLE_KEY_ID"
# APPLE_PRIVATE_KEY and OAUTH_SIGNING_SECRET are Wrangler secrets.
# Optional exact OAuth redirect URL -> server-owned client display name map:
# MCP_VERIFIED_CLIENTS = '{"https://client.example/callback":"My Agent"}'
# The saved account IANA time zone controls calendar days; there is no global
# quiz-date override and callers cannot submit a fictitious current date.
# Optional, dedicated synthetic App Review tenant UUIDs (never real Apple accounts):
# REVIEW_TENANT_IDS = "REPLACE_WITH_SYNTHETIC_REVIEW_TENANT_UUID"
# OpenAI supplies this exact public ownership challenge during portal setup:
# OPENAI_APPS_CHALLENGE_TOKEN = "REPLACE_WITH_PORTAL_CHALLENGE"

[[routes]]
pattern = "api.example.com"
custom_domain = true

[[d1_databases]]
binding = "DB"
database_name = "00quiz"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

# Choose namespace IDs unique within your Cloudflare account.
[[ratelimits]]
name = "SOURCE_LIMITER"
namespace_id = "23001"
  [ratelimits.simple]
  limit = 600
  period = 60

[[ratelimits]]
name = "SIGN_IN_LIMITER"
namespace_id = "23002"
  [ratelimits.simple]
  limit = 20
  period = 60

[[ratelimits]]
name = "TENANT_LIMITER"
namespace_id = "23003"
  [ratelimits.simple]
  limit = 300
  period = 60

# Daily sweep of expired OAuth flows, codes, and credentials. Workers Free
# allows five crons per account; Paid allows 250.
[triggers]
crons = ["17 4 * * *"]

# Run the Worker near the D1 primary when that makes requests faster: every
# request makes several sequential database calls.
[placement]
mode = "smart"

# Workers Paid only: cap CPU per request well below the 30 s default, so a
# runaway or abusive request cannot run up the bill. Normal requests use a few
# milliseconds. Check p99 CPU in the dashboard before lowering this.
# [limits]
# cpu_ms = 500

[observability]
enabled = true
